# PS Editor - Ceviri + pipeline (adim 4/5) ortam degiskenleri.
#
# Bu dosyayi kopyalayip python/.env olarak kaydedin:
#   copy python\.env.example python\.env
#
# ---------------------------------------------------------------------------
# 1) CRUZLI ANAHAR DEPOSU (adim 5, ONCELIKLI)
#   API anahtarlari artik OS guvenli deposuna saklanir (keyring):
#     Windows  -> Credential Manager
#     macOS    -> Keychain
#     Linux    -> Secret Service (GNOME/KDE)
#   Depoya yazmak icin sidecar komutu:
#     {"cmd": "set_api_key", "payload": {"provider": "openai_compat",
#                                        "api_key": "sk-..."}}
#   Asagidaki .env degiskenleri YALNIZCA gelistirme fallback'idir.
#
# ---------------------------------------------------------------------------
# 2) SAGLAYICI SECIMI (LLM_PROVIDER)
#   LLM_PROVIDER, onceki adimlardaki gibi 'auto' (anket: gecis) icin korunur:
#   auto  -> LLM_API_KEY (.env) veya guvenli depoda anahtar varsa 'api',
#            yoksa 'mock' (test)
#   local -> yerel Ollama (anahtar gerekmez)
#   api   -> asagidaki saglayicilardan biri
#   saglayici: openai | openai_compat | anthropic | mock
#
#   openai        : OpenAI resmi ucnoktasi (BASE_URL bos birakilabilir)
#   openai_compat : OpenAI-uyumlu HER ucnokta:
#                     Groq:     LLM_BASE_URL=https://api.groq.com/openai/v1
#                     Together: LLM_BASE_URL=https://api.together.xyz/v1
#                     DeepSeek: LLM_BASE_URL=https://api.deepseek.com/v1
#                     LM Studio:LLM_BASE_URL=http://localhost:1234/v1
#                     Ollama:   LLM_BASE_URL=http://localhost:11434/v1
#   anthropic     : Claude Messages API (OpenAI formati DEGILDIR; ayri backend)
#
# ---------------------------------------------------------------------------
# 3) MOD KARARI: auto | local | api  (LLM_TRANSLATION_MODE)
#   auto  -> VRAM esigine gore karar (asagidaki PS_VRAM_* degiskenleri)
#   local -> her zaman Ollama
#   api   -> her zaman LLM_PROVIDER'da secili saglayici
#
# Kod: pipeline.py / resolve_translation_mode; esikler:
#   local_model_icin_yer = free_vram - PS_VRAM_MEDIA_RESERVE_MB
#                                    - PS_VRAM_HEADROOM_MB
#   yer >= PS_VRAM_TRANSLATION_MIN_MB  ->  local
#   Varsayilanlar ORTALAMA ~7 GiB toplam VRAM'e denk gelir (6-8 GiB bandi).

LLM_PROVIDER=auto
LLM_TRANSLATION_MODE=auto

# --- OpenAI-uyumlu saglayicilar (openai / openai_compat) ---
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4.1-mini
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=120

# --- Anthropic Claude ---
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=4096

# --- Yerel Ollama (local mod) ---
# OLLAMA_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.1

# --- Pipeline ayarlari (adim 5; translate_page payload "settings" ile de
#     asilabilir - komut ici override env'den ONCELIKLIDIR) ---
# OCR+inpainting modellerinin ayni anda tutabilecegi VRAM rezervi (MiB):
PS_VRAM_MEDIA_RESERVE_MB=2048
# Isletim sistemi / diger uygulamalar icin headroom (MiB):
PS_VRAM_HEADROOM_MB=1024
# Yerel ceviri modelinin calisabilmesi icin gereken minimum VRAM (MiB):
PS_VRAM_TRANSLATION_MIN_MB=4096

PS_OCR_CONF=0.3
PS_OCR_FORCE_CPU=0
PS_INPAINT_METHOD=lama        # lama | opencv
PS_INPAINT_DEVICE=auto        # auto | cuda | cpu
PS_INPAINT_DILATE=4
PS_INPAINT_BUBBLE_MARGIN=0.08
PS_INPAINT_RING_WIDTH=10
PS_LAMA_MAX_SIDE=2048
PS_INPAINT_NO_REFINE=0
PS_TYPEFACE_FONT=fonts/ComicNeue-Bold.ttf
PS_TYPEFACE_MIN_SIZE=9
PS_TYPEFACE_MAX_SIZE=36
PS_SAVE_INTERMEDIATE=1
PS_DEBUG=0