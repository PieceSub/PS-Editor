# PS Editor - Ceviri + typesetting prototipi (adim 4) ortam degiskenleri.
#
# Bu dosyayi kopyalayip python/.env olarak kaydedin:
#   copy python\.env.example python\.env
#
# LLM_PROVIDER=auto  -> .env'de LLM_API_KEY varsa openai_compat, yoksa mock
#                       (mock: API gerektirmeyen deterministik test cevirisi)
#
# openai_compat, OpenAI ile uyumlu HER ucnoktayi destekler:
#   OpenAI:        LLM_BASE_URL bos birakin, LLM_MODEL=gpt-4.1-mini vb.
#   Ollama (yerel): LLM_BASE_URL=http://localhost:11434/v1
#                   LLM_MODEL=llama3.1
#   LM Studio:      LLM_BASE_URL=http://localhost:1234/v1
#   Groq:           LLM_BASE_URL=https://api.groq.com/openai/v1
#   Together:       LLM_BASE_URL=https://api.together.xyz/v1

LLM_PROVIDER=auto
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4.1-mini
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=120